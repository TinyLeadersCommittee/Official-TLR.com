---
import BaseLayout from '../layouts/BaseLayout.astro';
import bgImage from '../assets/images/construction/plumbTheForbidden.jpg';
---

<BaseLayout title="Under Construction" 
bgImage={bgImage} 
bgBlur={true}
bgStyle="object-fit: contain; object-position: center;">
  <header class="page-header prose-block">
    <h1>Area Restricted</h1>
    <p>This section of the archives is currently being forged.</p>
  </header>

  <section class="construction-container">
    <div class="construction-card">
      <span class="status-tag">Work in Progress</span>
      <h2>Pardon Our Dust</h2>
      <p>
        The Committee is hard at work digitizing the rules, lore, and history 
        of Tiny Leaders: Reborn. Check back soon for updates as we bring 
        this section online.
      </p>
      
      <div class="action-row">
        <a href="/" class="btn-primary">
          &larr; Return to Home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .construction-container {
    max-width: 650px;
    margin: 0 auto 5rem auto;
    padding: 0 1rem;
  }

  .construction-card {
    /* Barely-there background tint */
    background: linear-gradient(
      to bottom right, 
      rgba(20, 20, 25, 0.3) 0%, 
      rgba(20, 20, 25, 0.05) 100%
    );
    border: 1px solid var(--accent);
    border-radius: 8px;
    padding: 3rem 2rem;
    
    /* Slightly darker shadow to frame the text since the background is so clear */
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5); 
    
    /* Lower blur so the actual artwork details show through */
    backdrop-filter: blur(6px); 
    -webkit-backdrop-filter: blur(6px);
    
    text-align: center;
  }

  .status-tag {
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: bold;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .construction-card h2 {
    color: var(--heading-color);
    margin: 0 0 1rem 0;
    font-size: 2rem;
  }

  .construction-card p {
    color: var(--text-body);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 auto 2.5rem auto;
    max-width: 500px;
  }

  /* Light Mode Override */
  :global([data-theme="light"]) .construction-card,
  :global([data-theme="charlotte"]) .construction-card {
    background: linear-gradient(
      to bottom right, 
      rgba(255, 255, 255, 0.3) 0%, 
      rgba(255, 255, 255, 0.05) 100%
    );
    border-color: var(--accent);
    box-shadow: 0 8px 30px rgba(0,0,0,0.1);
  }
</style>