---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import ToolkitCTA from '../../components/ToolkitCTA.astro';
import discoverBg from '../../assets/images/discover/discoverTheImpossible.jpg';
import { exploreCards, discordBanner, mediaCards } from '../../data/discover/discover.js';
---

<BaseLayout title="Discover" bgImage={discoverBg}>
  
  <header class="page-header prose-block" style="margin: 0 auto;">
    <h1>Discover TLR</h1>
    <p>
      Tiny Leaders: Reborn is a fast, competitive 1v1 Magic format with 
      50-card singleton decks and a hard 3-mana-value cap. Built from 
      the original Tiny Leaders, TLR delivers tight, interactive games 
      that reward smart deckbuilding and precise play.
    </p>
  </header>

  <hr class="divider" />

  <section id="nexus">
    <h2>Explore the Format</h2>
    <nav class="grid-fluid">
      {exploreCards.map(card => (
        <a href={card.url} class="media-card interactive-card">
          <div 
            class="media-card-img" 
            style={`
              background-image: url('${card.img.src}'); 
              height: 180px; 
              background-position: ${card.bgPos || 'center'};
            `}
          ></div>
          <div class="media-card-body">
            <h3>{card.title}</h3>
            <p>{card.desc}</p>
            <span class="card-action" set:html={card.action}></span>
          </div>
        </a>
      ))}
    </nav>
  </section>

  <DiscordBanner />

  <section id="media" style="margin-top: 4rem;">
    <h2>Watch & Follow</h2>
    
    <div class="grid-fluid">
      {mediaCards.map(card => (
        <div class="media-card interactive-card">
          <div 
            class="media-card-img" 
            style={`background-image: url('${card.img.src}'); height: 180px;`}
          ></div>
          <div class="media-card-body">
            <h3>{card.platform}</h3>
            <p>{card.desc}</p>
            <a 
              href={card.url} 
              class={`social-btn ${card.cssClass}`} 
              target="_blank" 
              rel="noopener noreferrer"
            >
                <svg 
                  class="social-icon" 
                  xmlns="http://www.w3.org/2000/svg" 
                  viewBox={card.viewBox || "0 0 24 24"} 
                  fill="currentColor"
                >
                    <path d={card.svgPath}/>
                </svg>
                <span>{card.action}</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <hr class="divider" />

  <ToolkitCTA />

</BaseLayout>

<style>
  /* ======================================================================== */
  /* 1. LAYOUT OVERRIDES                                                      */
  /* ======================================================================== */
  
  #nexus .grid-fluid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    #nexus .grid-fluid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    #nexus .grid-fluid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ======================================================================== */
  /* 2. INTERACTIVE CARDS (Glass Effect Overrides)                            */
  /* Base geometry and hover transforms are handled globally by .media-card   */
  /* ======================================================================== */

  .interactive-card {
    /* We only need to apply the specific glass textures here */
    background: linear-gradient(
      to right, rgba(20, 20, 25, 0.9) 0%, rgba(20, 20, 25, 0.1) 100%
    );
    border-color: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }

  .interactive-card:hover {
    background: linear-gradient(
      to right, rgba(30, 30, 35, 0.95) 0%, rgba(30, 30, 35, 0.3) 100%
    );
  }

  /* Light Mode Overrides */
  :global([data-theme="light"]) .interactive-card,
  :global([data-theme="charlotte"]) .interactive-card {
    background: linear-gradient(
      to right, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.1) 100%
    );
    border-color: rgba(255, 255, 255, 0.4);
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
  }

  :global([data-theme="light"]) .interactive-card:hover,
  :global([data-theme="charlotte"]) .interactive-card:hover {
    background: linear-gradient(
      to right, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.3) 100%
    );
  }

  /* Minor typography spacing tweaks (Colors inherited globally) */
  .media-card-body h3 { margin: 0 0 0.5rem 0; font-size: 1.25rem; }
  .media-card-body p { margin: 0 0 1rem 0; font-size: 0.95rem; }
  
  .card-action { 
    font-weight: bold; color: var(--accent); 
    display: inline-block; margin-top: auto; 
  }

  /* ======================================================================== */
  /* 4. MEDIA SOCIAL BUTTONS                                                  */
  /* ======================================================================== */

  .social-btn {
    display: inline-flex; align-items: center; gap: 0.5rem; 
    padding: 0.6rem 1.2rem; border-radius: 6px; text-decoration: none; 
    color: #fff; font-weight: bold; font-size: 0.95rem; 
    transition: all 0.2s; margin-top: 1rem; width: fit-content;
  }
  
  .social-btn:hover { transform: translateY(-2px); filter: brightness(110%); }
  .social-icon { width: 20px; height: 20px; }
  .btn-youtube { background-color: #FF0000; }
  .btn-bluesky { background-color: #0560FF; }
</style>