---

<html lang="en" data-theme="committee">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
  </head>
  
  <body>
    {/* 1. The Art Layer (Blurred and scaled slightly to hide edges) */}
    <div 
      class="bg-art" 
      style={`background-image: url('${bgImage.src}');`}
    ></div>
    
    {/* 2. The Tint Layer (Darkens the art so text remains legible) */}
    <div class="bg-tint"></div>

    <main class="links-container">
      
      <header class="profile-header">
        <div class="avatar-circle">
          <img src="/assets/logo-placeholder.png" alt="TLR Logo" />
        </div>
        <h1>Tiny Leaders: Reborn</h1>
        <p class="bio-text">
          50 Cards. 3 Mana. Infinite Strategy.<br>
          The official hub for the format.
        </p>
      </header>

      <div class="link-stack">
        {links.map((link) => (
          <a 
            href={link.url} 
            class={`brand-btn ${link.cssClass}`} 
            target={link.url.startsWith('http') ? "_blank" : "_self"}
          >
            {/* Left Icon */}
            <svg 
              class="brand-icon" 
              xmlns="http://www.w3.org/2000/svg" 
              viewBox={link.viewBox} 
              fill="currentColor"
            >
                <path d={link.svgPath}/>
            </svg>
            
            <span>{link.action}</span>
          </a>
        ))}
      </div>

    </main>
  </body>
</html>

<style>
  /* --- PAGE SETUP --- */
  body {
    margin: 0;
    min-height: 100vh;
    font-family: var(--font-body, system-ui, sans-serif);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Cinematic Background Setup */
  .bg-art {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover; background-position: center;
    filter: blur(2px); transform: scale(1.1); 
    z-index: -2;
  }

  .bg-tint {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    /* Lowered from 0.75 to 0.4 for a much lighter tint */
    background: rgba(20, 20, 25, 0.5); 
    z-index: -1;
  }

  /* --- CONTAINER --- */
  .links-container {
    width: 100%; max-width: 450px; 
    padding: 4rem 1.5rem; text-align: center;
    position: relative; z-index: 1; /* Keeps it above the bg */
  }

  /* --- HEADER --- */
  .profile-header { margin-bottom: 3rem; }

  .avatar-circle {
    width: 96px; height: 96px; margin: 0 auto 1.5rem; border-radius: 50%;
    background: var(--surface); border: 2px solid var(--accent);
    padding: 4px; box-shadow: 0 4px 20px rgba(0,0,0,0.5);
  }

  .avatar-circle img {
    width: 100%; height: 100%; object-fit: cover;
    border-radius: 50%; display: block;
  }

  h1 {
    font-size: 1.8rem; margin: 0 0 0.5rem 0;
    color: #ffffff; /* Forced pure white for contrast */
    font-family: var(--font-heading, sans-serif); font-weight: 800;
  }

  .bio-text {
    color: #cccccc; /* Forced light gray */
    font-size: 1rem; line-height: 1.5; margin: 0;
  }

  /* --- LINK STACK & BUTTONS --- */
  .link-stack {
    display: flex; flex-direction: column; gap: 1rem; width: 100%;
  }

  .brand-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center; /* Centers the whole group */
    gap: 0.75rem; /* Adds perfect breathing room between icons and text */
    width: 100%;
    /* Keep the padding standard, but ensure box-sizing includes it */
    box-sizing: border-box; 
    padding: 1.1rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    font-size: 1.1rem;
    color: #ffffff;
    transition: transform 0.2s ease, filter 0.2s ease, box-shadow 0.2s ease;
  }

  .brand-btn:hover {
    transform: translateY(-3px);
    filter: brightness(110%);
    box-shadow: 0 6px 20px rgba(0,0,0,0.25);
  }

  /* Let the icon flow naturally in the flex container */
  .brand-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0; /* Prevents the icons from squishing if text is long */
  }

  /* Specific Brand Colors */
  
  /* Website gets a premium Frosted Glass look so it matches the TLR theme */
  .btn-website { 
    background: rgba(255, 255, 255, 0.1); 
    border: 1px solid rgba(255, 255, 255, 0.2); 
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .btn-website:hover { background: rgba(255, 255, 255, 0.15); border-color: var(--accent); }
  
  .btn-discord { background-color: #5865F2; border: 1px solid #5865F2; }
  .btn-youtube { background-color: #FF0000; border: 1px solid #FF0000; }
  .btn-bluesky { background-color: #0560FF; border: 1px solid #0560FF; }
</style>