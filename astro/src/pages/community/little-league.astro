---
import BaseLayout from '../../layouts/BaseLayout.astro';
import battle from '../../assets/images/community/battleStrain.jpg';
import join from '../../assets/images/community/kellanJoinsUp.jpg';

import { 
  leagueSchedule, 
  leagueRules, 
  seasonalEvents 
} from '../../data/community/littleLeagueData.js';
---

<BaseLayout title="Official Little League" 
bgImage={battle}
bgBlur={true}
bgStyle="object-fit: contain; object-position: center;">
  
  <header class="page-header">
    <h1>The Official TLR Little League</h1>
    <p>
      Whether you're a seasoned vet or new to the format, the Little League is 
      the best place to play, compete, and connect with the community.
    </p>
    <p>
      <strong>The Goal?</strong> Survive the seasons, conquer the Second 
      Chances Tournament, and qualify for the Tiny Titans Top 8 Championship.
    </p>
  </header>

  <section class="callout-box">
    <blockquote>
      "The monthly leagues are there to offer everyone a place to play 
      <strong>organized</strong>, <strong>accessible</strong>, 
      <strong>low-stakes</strong> Tiny Leaders."
    </blockquote>
    <div class="citation">
       — Fishe, Committee Advisor
       <a href="/community/league-philosophy" class="read-more">Read full statement &rarr;</a>
    </div>
  </section>

  <hr />

  <section id="monthlies">
    <div class="prose-block" style="text-align: center; margin-bottom: 2rem;">
        <h2>The Core Events: Monthly Swiss</h2>
        <p>
          Your regular dose of Tiny Leaders. Every month, the Committee hosts 
          a flexible, community-friendly tournament.
        </p>
    </div>

    <div class="rules-grid">
      {leagueRules.map((rule) => (
        <article class="media-card">
          <div 
            class="media-card-img" 
            style={`
                background-image: url('${rule.image.src}'); 
                background-position: ${rule.position || 'center'}; 
                height: 160px;
            `}
          ></div>
          
          <div class="media-card-body text-center">
            <div class="icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
                <path d={rule.iconPath}/>
              </svg>
            </div>
            <h3>{rule.title}</h3>
            <p set:html={rule.text} />
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="seasons">
    <div class="prose-block" style="text-align: center; margin-top: 3rem;">
        <h2>The Road to Glory: Seasonal Play</h2>
        <p>
          Although we play <i>almost</i> every month, the year is divided into two major 
          competitive seasons: <strong>Spring</strong> and <strong>Fall</strong>.
        </p>
    </div>
    
    <div class="events-container">
      {seasonalEvents.map((event) => (
        <article class={`media-card ${event.cssClass}`}>
            
            <div 
                class="media-card-img" 
                style={`
                    background-image: url('${event.image.src}');
                    background-position: ${event.position || 'center'};
                    height: 300px;
                `}
            ></div>

            <div class="media-card-body">
                <header>
                    <h3>{event.title}</h3>
                    <span class="event-meta">{event.meta}</span>
                </header>
                <p set:html={event.description} />
                
                <ul class="specs-list">
                    {event.specs.map((spec) => (
                        <li set:html={spec} />
                    ))}
                </ul>
                
                {/* Warning Box */}
                {event.warning && (
                    <div class="alert-box warning">
                        <div class="alert-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                                <path d="M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/>
                            </svg>
                        </div>
                        <p set:html={event.warning} />
                    </div>
                )}
            </div>
        </article>
      ))}
    </div>
  </section>

  <hr />

  <section id="schedule">
    <h2 style="text-align: center;">2026 Tentative Schedule</h2>
    
    <div class="schedule-grid">
      <div class="schedule-header">
        <span>Dates</span>
        <span>Event</span>
        <span>Type</span> 
      </div>
      
      {leagueSchedule.map((item) => (
        <div class={`schedule-row ${item.type}`}>
          <div class="date-col">{item.date}</div>
          <div class="event-col">
            {item.type === "major" || item.type === "championship" ? (
              <strong>{item.event}</strong>
            ) : (
              item.event
            )}
          </div>
          <div class="type-col">
            {item.type.replace("-", " ")} 
          </div>
        </div>
      ))}
    </div>
  </section>

  <hr />

  <aside id="resources" class="media-card join-card">
    
    <div 
      class="media-card-img" 
      style={`
        background-image: url('${join.src}'); 
        background-position: center 15%;
        height: 250px; 
      `}
    ></div>

    <div class="media-card-body text-center">
      <h3>Ready to Join?</h3>
      <p>
        Visit the <strong>Official TLR Little League</strong> section in Discord 
        and click on <strong>#tlr-little-league-info</strong> for more detailed 
        information. Then, head to <strong>#channels-and-roles</strong> and select
        the <span class="tag-pill">@TLR Little League</span> role to get notified
        when registration opens, each month.
      </p>
      <nav class="resource-links">
        <a href="https://challonge.com" class="btn" target="_blank" rel="noopener noreferrer">Visit Challonge</a>
        <a href="https://cockatrice.github.io/" class="btn" target="_blank" rel="noopener noreferrer">Download Cockatrice</a>
      </nav>
    </div>

  </aside>
</BaseLayout>

<style>
  /* --- PAGE LAYOUTS & GRIDS --- */
  .rules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .rules-grid .media-card-body h3 {
    margin-top: 0;      
    margin-bottom: 0.50rem; 
    font-size: 1.2rem;  
  }

  .rules-grid .media-card-body p {
    margin-top: 0;      
    margin-bottom: 0;
    line-height: 1.4;   
    font-size: 0.95rem;
  }
  
  .icon-wrapper {
    color: var(--accent);
    margin-bottom: 0.5rem; 
    display: inline-flex;
    padding: 12px;
    background-color: var(--surface);
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
  }

  /* --- SEASONAL EVENTS LAYOUT --- */
  .events-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
  }

  .events-container .media-card-body h3 {
    margin-top: 0;
    margin-bottom: 0.25rem; 
    font-size: 1.5rem;
  }

  .events-container .event-meta {
    margin-bottom: 1rem;    
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .events-container .media-card-body p {
    margin-top: 0;          
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .events-container .specs-list {
    margin-top: 0;          
    margin-bottom: 1.5rem;
    padding-left: 1.2rem;
  }

  .resource-links {
    margin-top: 1.5rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap; 
  }

  /* --- LOCAL COMPONENTS --- */
  .alert-box {
    display: flex;
    gap: 1rem;
    background-color: var(--surface);
    border: 1px solid var(--border-subtle);
    border-left: 4px solid var(--accent);
    padding: 1rem;
    border-radius: 4px;
    margin-top: 1.5rem;
    font-size: 0.95rem;
    color: var(--text-body);
  }

  .alert-icon {
    color: var(--accent);
    flex-shrink: 0;
    padding-top: 2px;
  }

  .callout-box blockquote {
    font-size: 1.1rem;
    margin: 0 0 1rem 0;
    line-height: 1.6;
    font-style: italic;
  }

  .citation {
    font-size: 0.9rem;
    color: var(--text-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .read-more {
    font-weight: bold;
    font-size: 0.85rem;
  }

  .event-meta {
    display: block;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 1rem;
    font-weight: bold;
  }

  .specs-list {
    margin: 1rem 0;
    padding-left: 1.2rem;
    color: var(--text-body);
  }

  .championship-card {
    background-color: var(--surface); 
    border-color: var(--accent);
  }

  /* --- SCHEDULE GRID --- */
  .schedule-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .schedule-header {
    display: grid;
    grid-template-columns: 180px 350px 1fr; 
    font-weight: bold;
    padding: 0.5rem 1rem;
    border-bottom: 2px solid var(--border-subtle);
    color: var(--text-muted);
    text-transform: uppercase;
    font-size: 0.85rem;
  }

  .schedule-row {
    display: grid;
    grid-template-columns: 180px 350px 1fr; 
    padding: 0.75rem 1rem;
    border-radius: 4px;
    align-items: center;
    background-color: var(--surface);
    color: var(--text-body);
    border: 1px solid transparent; 
  }

  .type-col {
    text-transform: capitalize;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* Schedule Status Colors */
  .schedule-row.major, 
  .schedule-row.championship {
    background-color: var(--bg);
    border-left: 4px solid var(--accent);
    border-top: 1px solid var(--border-subtle);
    border-right: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    font-weight: bold;
  }

  .schedule-row.qualifier {
    border-left: 4px solid var(--text-muted); 
  }

  .schedule-row.special {
    border-left: 4px solid #FFD700; 
  }

  /* --- RESPONSIVE --- */
  @media (max-width: 600px) {
    .schedule-header { display: none; }
    
    .schedule-row {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      border-left-width: 4px; 
    }
    
    .date-col { 
      font-size: 0.85rem; 
      color: var(--text-muted); 
      font-weight: bold; 
    }
    
    .type-col {
      background-color: var(--border-subtle);
      padding: 2px 8px;
      border-radius: 4px;
      margin-top: 4px;
      font-size: 0.8rem;
    }
  }
</style>