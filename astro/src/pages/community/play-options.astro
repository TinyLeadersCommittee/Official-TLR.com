---
import BaseLayout from '../../layouts/BaseLayout.astro';
import swindler from '../../assets/images/community/tavernSwindler.jpg';
import { eventPosters } from '../../data/community/eventPosterData.js';
---

<BaseLayout title="More Ways to Play" 
bgImage={swindler}
bgBlur={true}
bgStyle="object-fit: contain; object-position: center;">
  
  <main class="prose-block" style="max-width: 1200px;">

    <header class="page-header">
      <h1>More Ways to Play</h1>
      <p>
        Tiny Leaders: Reborn is played in many ways beyond scheduled tournaments.
        These are some of the most active ways the community plays today.
      </p>
    </header>

   <div class="poster-grid">
      {eventPosters.map((event) => (
        <article class="event-poster">
          
          <div 
            class="event-poster-bg" 
            style={`background-image: url('${event.image.src}');`}
          ></div>
          
          <div class="event-poster-body">
            
            <span class={`event-poster-tag status-${event.statusColor}`}>
              {event.status}
            </span>

            <h3>{event.title}</h3>
            <p>{event.description}</p>
            
            {event.details.length > 0 && (
              <ul>
                  {event.details.map((detail) => (
                    <li set:html={detail} />
                  ))}
              </ul>
            )}
          </div>

        </article>
      ))}
    </div>
    
  </main>
</BaseLayout>

<style>
  /* Local Grid Layout */
  .poster-grid {
    display: grid;
    /* This creates a fluid grid that fits as many 300px cards as possible */
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
    padding: 2rem 0;
  }
</style>