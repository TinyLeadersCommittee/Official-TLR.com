---
import LegalFooter from '../components/footer/LegalFooter.astro';
import { SITE_LINKS } from '../config/links';
import bgImage from '../assets/images/splash-page/eld-64-so-tiny.jpg';
import { Image } from 'astro:assets';
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>Tiny Leaders</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@900&display=swap" rel="stylesheet">
    <link rel="manifest" href="/manifest.json" />
    
    <style>
        /* FONTS & VARIABLES */
        @font-face {
            font-family: 'BrotherSignature';
            src: url('/fonts/BrotherSignature-7BWnK.otf') format('opentype'); 
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }

        :root, [data-theme='light'] {
            --bg: #f0f0f0;
            --text: #111;
            --accent: #ff4d00;
        }

        [data-theme='dark'] { --bg: #0a0a0a; --text: #fff; --accent: #ff4d00; }
        [data-theme='committee'] { --bg: #1a1a1a; --text: #eee; --accent: #9c27b0; }
        [data-theme='charlotte'] { --bg: #111; --text: #fff; --accent: #ff69b4; }

        /* GLOBAL LAYOUT */
        body {
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            height: 100vh;
            height: 100dvh; 
            display: flex;
            flex-direction: column;
            transition: background-color 0.3s ease, color 0.3s ease;
            font-family: 'Montserrat', sans-serif;
            position: relative; 
            overflow: hidden; 
        }

        /* BACKGROUND LAYER */
        .fullscreen-bg {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            z-index: 0; pointer-events: none;
        }

        .bg-img {
            width: 100%; height: 100%; object-fit: cover;
            opacity: 0.35; 
            filter: grayscale(0%);
            transition: all 0.5s ease;
        }

        [data-theme='dark'] .bg-img,
        [data-theme='committee'] .bg-img,
        [data-theme='charlotte'] .bg-img {
            filter: grayscale(100%); 
            opacity: 0.15; 
        }

        /* MAIN CONTENT */
        .totem-container {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            flex: 1; text-align: center;
            margin: auto; padding: 1rem;
            position: relative; z-index: 5; 
            width: 100%; max-width: 1400px; 
        }

        .slogan-top {
            font-family: 'BrotherSignature', cursive;
            font-size: 3.5rem; color: var(--accent);
            margin-bottom: -1rem; transform: rotate(-5deg);
            letter-spacing: 2px;
            position: relative; z-index: 10;
        }

        .logo-space {
            height: 2rem; 
            width: 100%;
        }

        .logo-main {
            font-size: clamp(3rem, 13vw, 7rem); letter-spacing: -4px;
            line-height: 0.8; text-transform: uppercase; margin: 0;
            white-space: nowrap;
        }

        .reborn-sub {
            font-size: 2rem; font-weight: 300; letter-spacing: 16px;
            text-transform: uppercase; opacity: 0.9; margin-top: 1rem; 
        }

        :root .slogan-top, :root .logo-main, :root .reborn-sub,
        [data-theme='light'] .slogan-top, [data-theme='light'] .logo-main, [data-theme='light'] .reborn-sub {
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
        }

        [data-theme='dark'] .slogan-top, [data-theme='dark'] .logo-main, [data-theme='dark'] .reborn-sub,
        [data-theme='committee'] .slogan-top, [data-theme='committee'] .logo-main, [data-theme='committee'] .reborn-sub,
        [data-theme='charlotte'] .slogan-top, [data-theme='charlotte'] .logo-main, [data-theme='charlotte'] .reborn-sub {
            text-shadow: 0 4px 30px rgba(0,0,0,0.9);
        }

        /* GATEWAY NAVIGATION */
        .gateway-nav {
            margin-top: 6rem; display: flex; align-items: center; gap: 1.5rem;
            opacity: 0; animation: fadeIn 2s forwards 1s;
        }

        .gateway-nav a {
            color: var(--text); text-decoration: none;
            font-size: 1.25rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 4px; transition: color 0.3s ease, transform 0.3s ease;
        }

        .gateway-nav a:hover {
            color: var(--accent); transform: translateY(-3px);
        }

        .nav-dot {
            color: var(--accent); font-size: 1.5rem; line-height: 0; opacity: 0.5;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* FOOTER */
        .splash-footer-container {
            width: 100%; position: relative; z-index: 30;
            display: flex; flex-direction: column; align-items: center;
            padding-bottom: 2rem; margin-top: auto; 
            background: linear-gradient(to top, var(--bg) 20%, rgba(240, 240, 240, 0.95) 75%, transparent 100%);
        }

        :root .splash-footer-container :global(*),
        [data-theme='light'] .splash-footer-container :global(*) {
            color: #333 !important; 
        }

        :root .splash-footer-container :global(h1),
        :root .splash-footer-container :global(h2),
        :root .splash-footer-container :global(h3),
        :root .splash-footer-container :global(h4),
        [data-theme='light'] .splash-footer-container :global(h1),
        [data-theme='light'] .splash-footer-container :global(h2),
        [data-theme='light'] .splash-footer-container :global(h3),
        [data-theme='light'] .splash-footer-container :global(h4) {
            color: #000 !important;
            font-weight: 600 !important;
            opacity: 1 !important; 
        }

        [data-theme='dark'] .splash-footer-container,
        [data-theme='committee'] .splash-footer-container,
        [data-theme='charlotte'] .splash-footer-container {
            background: linear-gradient(to top, var(--bg) 20%, rgba(10, 10, 10, 0.95) 75%, transparent 100%);
        }
        
        [data-theme='dark'] .splash-footer-container :global(*),
        [data-theme='committee'] .splash-footer-container :global(*),
        [data-theme='charlotte'] .splash-footer-container :global(*) {
            color: #ccc !important; 
        }

        [data-theme='dark'] .splash-footer-container :global(h1),
        [data-theme='dark'] .splash-footer-container :global(h2),
        [data-theme='dark'] .splash-footer-container :global(h3),
        [data-theme='dark'] .splash-footer-container :global(h4),
        [data-theme='committee'] .splash-footer-container :global(h1),
        [data-theme='committee'] .splash-footer-container :global(h2),
        [data-theme='committee'] .splash-footer-container :global(h3),
        [data-theme='committee'] .splash-footer-container :global(h4),
        [data-theme='charlotte'] .splash-footer-container :global(h1),
        [data-theme='charlotte'] .splash-footer-container :global(h2),
        [data-theme='charlotte'] .splash-footer-container :global(h3),
        [data-theme='charlotte'] .splash-footer-container :global(h4) {
            color: #fff !important;
            font-weight: 600 !important;
            opacity: 1 !important;
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            .slogan-top { 
                font-size: 2.5rem; 
                margin-bottom: -1.8rem; 
            }
            
            .logo-main { 
                font-size: clamp(2.5rem, 13vw, 4.5rem); 
            }
            
            .reborn-sub { 
                font-size: 0.9rem; 
                letter-spacing: 6px; 
                margin-top: 0.5rem; 
            }
            
            .gateway-nav { 
                flex-direction: column; 
                gap: 1rem; 
                margin-top: 2.5rem; 
                width: 100%;
            }
            
            .gateway-nav a { 
                font-size: 1.35rem; 
                display: block; 
                width: 100%; 
                padding: 0.25rem 0;
            }
            
            .nav-dot { display: none; }
            
            .splash-footer-container { 
                padding-bottom: 0.25rem; 
                padding-top: 0.5rem;
                background: linear-gradient(to top, var(--bg) 10%, rgba(240, 240, 240, 0.95) 40%, transparent 100%);
            }
            
            [data-theme='dark'] .splash-footer-container,
            [data-theme='committee'] .splash-footer-container,
            [data-theme='charlotte'] .splash-footer-container {
                background: linear-gradient(to top, var(--bg) 10%, rgba(10, 10, 10, 0.95) 40%, transparent 100%);
            }
            
            .splash-footer-container :global(*) {
                font-size: 0.65rem !important;
                line-height: 1.1 !important;
                margin-top: 0 !important;
                margin-bottom: 0.1rem !important;
                padding: 0 !important;
            }
        }
    </style>
</head>
<body>

    <div class="fullscreen-bg">
        <Image src={bgImage} alt="Background" class="bg-img" />
    </div>

    <main class="totem-container">
        <span class="slogan-top">Big Plays</span>
        
        <div class="logo-space"></div>
        
        <h1 class="logo-main">Tiny Leaders</h1>
        <span class="reborn-sub">Reborn</span>
        
        <nav class="gateway-nav">
            <a href={SITE_LINKS.navigation.discover}>Discover</a>
            <span class="nav-dot">&bull;</span>
            <a href={SITE_LINKS.navigation.play}>Play</a> 
            <span class="nav-dot">&bull;</span>
            <a href={SITE_LINKS.navigation.master}>Master</a> 
        </nav>
    </main>

    <div class="splash-footer-container">
        <LegalFooter />
    </div>

    <script is:inline>
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
</body>
</html>