---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MemberCard from '../../components/MemberCard.astro';
import sages from '../../assets/images/about/orderOfWhiteclay.jpg';
import { mainCommitteeSections, contributorConfig } from '../../data/committee/committee-config.js';
import { contributorTeams } from '../../data/contributors/contributor-config.js'; 
---

<BaseLayout title="The Committee" 
bgImage={sages}
bgBlur={true}
bgStyle="object-fit: contain; object-position: center;">
  
  <article class="committee-page">
    
    <header class="page-header">
      <h1>The People Behind TLR</h1>
      <p class="subtitle" style="color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em; font-weight: bold; font-size: 0.9rem;">
        Members of the Tiny Leaders Committee
      </p>
      <p class="lead">
        Dedicated to the stewardship, development, health, and growth of the <br> 
        Tiny Leaders Reborn format.
      </p>
      
      {/* NEW: Interaction Prompt */}
      <div class="interaction-prompt">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
          <path d="M15 3h6v6"></path>
          <path d="M10 14 21 3"></path>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        </svg>
        <span>Select a member to view their official bio and custom Tiny Leader.</span>
      </div>
    </header>

    {/* =========================================
        CORE COMMITTEE SECTIONS (Collapsible)
        ========================================= */}
    {mainCommitteeSections.map(section => {
      const sectionId = section.title.replace(/\s/g, '');
      const rowShape = section.shape || 'circle';

      return (
        <section class="role-section" style={`--role-color: ${section.color}`}>
          
          <button class="role-header accordion-toggle" onclick={`toggleAccordion('${sectionId}')`}>
            <div class="header-content">
              <h2>{section.title}</h2>
              <p class="role-description">{section.description}</p>
            </div>
            <span id={`icon-${sectionId}`} class="accordion-icon">▼</span>
          </button>
          
          <div id={`wrapper-${sectionId}`} class="section-wrapper open">
            <div class="members-grid">
              {section.members.map((member, index) => (
                <MemberCard member={member} sectionId={sectionId} index={index} shape={rowShape} />
              ))}
            </div>
          </div>

        </section>
      )
    })}

    {/* =========================================
        CONTRIBUTOR TEAMS SECTION
        ========================================= */}
    <section class="role-section contributors-section" style={`--role-color: ${contributorConfig.color}`}>
        
        <div class="role-header" style="cursor: default; pointer-events: none;">
            <div class="header-content">
                <h2 style="color: var(--role-color);">{contributorConfig.title}</h2>
                <p class="role-description">{contributorConfig.description}</p>
            </div>
        </div>

        {/* VIEW A: TEAM FOLDERS */}
        <div id="contrib-teams-list" class="members-grid">
            {contributorTeams.map(team => (
              <div style={`--role-color: ${team.color}; width: 100%;`}>
                <MemberCard member={team} shape={team.shape || 'nonagon'} />
              </div>
            ))}
        </div>

        {/* VIEW B: INDIVIDUAL TEAM DETAILS */}
        {contributorTeams.map(team => (
            <div id={`team-view-${team.id}`} class="team-detail-view hidden" style={`--role-color: ${team.color}`}>
                
                <div class="team-nav-header">
                    <button class="back-btn" onclick="showTeamsList()">← Back to Teams</button>
                    <h3>{team.title}</h3>
                </div>

                <div class="members-grid">
                    {team.members.map((member, index) => (
                        <MemberCard member={member} sectionId={team.id} index={index} shape="nonagon" />
                    ))}
                </div>
            </div>
        ))}
    </section>

    {/* FOOTER CALLOUT */}
    <div class="callout-box" style="text-align: center; margin-top: 5rem; cursor: pointer;" onclick="window.location.href='/committee'">
      <h3 style="margin-top: 0; color: var(--accent);">How does this all work?</h3>
      <p>Learn about how the Committee Functions, Votes, and Governs.</p>
    </div>

    {/* =========================================
        THE 3D MTG CARD MODAL OVERLAY
        ========================================= */}
    <div id="mtg-card-modal" class="card-modal-overlay hidden">
      <div class="card-modal-content">
        
        <button class="close-modal-btn" onclick="closeCardModal()">×</button>
        
        <div class="card-3d-scene">
          
          <div class="card-vertical-flipper" id="vertical-flipper">
            
            <div class="card-face bio-face">
              <img src="" alt="Committee Bio Card" id="modal-card-bio" />
            </div>
            
            <div class="card-face custom-face-container">
              
              <div class="card-horizontal-flipper" id="horizontal-flipper">
                
                <div class="card-face custom-front">
                  <img src="" alt="Custom MTG Card" id="modal-card-custom" />
                </div>
                
                <div class="card-face custom-back">
                  <img src="" alt="Related Card" id="modal-card-related" class="crossfade-target" />
                </div>
                
              </div>
            </div>
          </div>
        </div>

        <div class="modal-controls">
          <button id="main-flip-btn" class="transform-btn primary-btn" onclick="toggleVerticalFlip()">
            View Custom Tiny Leader
          </button>
          
          <div id="submenu-controls" class="submenu-container hidden">
             </div>
        </div>

      </div>
    </div>

    {/* =========================================
        MODAL SCRIPT
        ========================================= */}
    <script src="../../scripts/committeeModal.js"></script>

  </article>
</BaseLayout>

<style>
  .committee-page { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }

  .interaction-prompt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: 30px;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .role-section { margin-bottom: 4rem; }

  /* Accordion Header Styles */
  .role-header { 
    width: 100%; text-align: center; margin-bottom: 2rem; 
    background: transparent; border: none; cursor: pointer; 
    display: flex; align-items: center; justify-content: center; gap: 1rem;
    padding: 1rem; border-radius: 8px; transition: background 0.2s;
  }
  .role-header:hover { background: rgba(255,255,255,0.03); }
  
  .header-content { display: flex; flex-direction: column; align-items: center; }
  .header-content h2 { 
    color: var(--role-color, var(--heading-color)); 
    text-transform: uppercase; letter-spacing: 0.1em; 
    font-size: 1.5rem; margin: 0 0 0.5rem 0; 
  }
  .role-description { 
    color: var(--text-muted); font-style: italic; max-width: 700px; 
    margin: 0 auto; line-height: 1.5; 
  }
  
  .accordion-icon { display: inline-block; color: var(--role-color); font-size: 1.2rem; transition: transform 0.3s ease; }

  /* Section Wrapper Collapsing Logic */
  .section-wrapper { 
    display: grid; 
    grid-template-rows: 0fr; 
    transition: grid-template-rows 0.4s ease; 
  }
  .section-wrapper.open { grid-template-rows: 1fr; }
  .section-wrapper > div { overflow: hidden; }

  .members-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); 
    gap: 2rem; align-items: start; position: relative; padding-top: 1rem;
  }

  /* Contributor Styles */
  .contributors-section { border-top: 1px solid var(--border-subtle); padding-top: 4rem; margin-top: 4rem; }
  .team-nav-header { 
    display: flex; align-items: center; gap: 2rem; margin-bottom: 2rem; 
    padding-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); 
  }
  .team-nav-header h3 { margin: 0; font-size: 1.5rem; color: var(--role-color); }
  
  .back-btn { 
    background: transparent; border: 1px solid var(--role-color); color: var(--role-color); 
    padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; font-weight: bold; transition: all 0.2s; 
  }
  .back-btn:hover { background: var(--role-color); color: #fff; }
  
  .hidden { display: none; }
  .team-detail-view { animation: fadeIn 0.3s ease; }

  /* =========================================
     MODAL & 3D CARD CSS
     ========================================= */
  /* =========================================
     ADVANCED 3D MODAL CSS
     ========================================= */
  .card-modal-overlay {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(8px);
    z-index: 1000; display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: opacity 0.3s ease;
  }
  .card-modal-overlay.hidden { display: none; }
  .card-modal-overlay.visible { opacity: 1; }

  .card-modal-content {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: 1.5rem;
  }

  .close-modal-btn {
    position: absolute; top: -3rem; right: -2rem;
    background: transparent; border: none; color: #fff; font-size: 2.5rem;
    cursor: pointer; transition: color 0.2s, transform 0.2s;
  }
  .close-modal-btn:hover { color: var(--accent); transform: scale(1.1); }

  /* --- NESTED 3D SCENE --- */
  .card-3d-scene {
    width: 320px; height: 448px; 
    perspective: 1200px; 
  }
  @media (min-width: 768px) { .card-3d-scene { width: 400px; height: 560px; } }

  /* OUTER FLIPPER (Vertical / X-Axis) */
  .card-vertical-flipper {
    width: 100%; height: 100%; position: relative;
    transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
  }
  .card-vertical-flipper.is-flipped-vert { transform: rotateX(180deg); }

  /* Faces of the Outer Flipper */
  .bio-face { transform: rotateX(0deg); }
  .custom-face-container { transform: rotateX(180deg); } /* Sits upside down until flipped */

  /* INNER FLIPPER (Horizontal / Y-Axis) */
  .card-horizontal-flipper {
    width: 100%; height: 100%; position: relative;
    transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
  }
  
  /* Faces of the Inner Flipper */
  .custom-front { transform: rotateY(0deg); }
  .custom-back { transform: rotateY(180deg); } /* Used for MDFC, Tokens, Emblems */

  /* Universal Face Styles */
  .card-face {
    position: absolute; width: 100%; height: 100%;
    backface-visibility: hidden;
    border-radius: 4.75% / 3.5%;
    box-shadow: 0 15px 40px rgba(0,0,0,0.6);
  }
  .card-face img { width: 100%; height: 100%; object-fit: contain; border-radius: 4.75% / 3.5%; }

  /* Crossfade Utility */
  .crossfade-target { transition: opacity 0.3s ease; }
  .crossfade-target.fade-out { opacity: 0; }

  /* --- BUTTON CONTROLS --- */
  .modal-controls { display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .submenu-container { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; transition: opacity 0.3s; }
  .submenu-container.hidden { display: none; opacity: 0; }

  .transform-btn {
    background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255,255,255,0.3);
    color: #fff; padding: 0.75rem 1.5rem; border-radius: 30px;
    font-family: monospace; font-size: 1rem; cursor: pointer; transition: all 0.2s ease;
  }
  .primary-btn { text-transform: uppercase; letter-spacing: 1px; }
  .secondary-btn { font-size: 0.9rem; border-color: var(--accent); color: var(--accent); }
  .transform-btn:hover { background: var(--accent); border-color: var(--accent); color: #fff; box-shadow: 0 0 15px var(--accent); }
</style>