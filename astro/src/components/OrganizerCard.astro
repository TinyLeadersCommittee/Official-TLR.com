---
const { lpo } = Astro.props;

// Fallback Initials Generator
const getInitials = (name) => {
  if (!name) return "TL"; 
  const parts = name.trim().split(" ");
  if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
  return name.substring(0, 2).toUpperCase();
};

const initials = getInitials(lpo.name);
---

<article class="media-card lpo-profile-card">
  
  {lpo.bgImage && (
    <div 
      class="profile-bg-art" 
      style={{ backgroundImage: `url(${lpo.bgImage.src || lpo.bgImage})` }}
    ></div>
  )}

  <div class="profile-banner"></div>

  <div class="profile-content">
    <header class="profile-header">
      
      <div class="avatar-circle">
        {lpo.image ? (
          <img 
            src={lpo.image.src || lpo.image} 
            alt={`${lpo.name}'s Profile Picture`} 
            class="avatar-img" 
            loading="lazy" 
          />
        ) : (
          <span>{initials}</span>
        )}
      </div>

      <div class="profile-identity">
        <h2>{lpo.name || "Community Leader"}</h2>
        <span class="role-badge">{lpo.role}</span>
      </div>
    </header>

    <div class="profile-meta-tags">
      <div class="meta-tag location-tag">
        <a 
        href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(lpo.location)}`}
        target="_blank"
        rel="nofollow noreferrer"
        class="meta-tag location-tag clickable-tag"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
          <path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.273 1.765 11.842 11.842 0 00.976.544l.02.01.006.004zM10 11.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z" clip-rule="evenodd" />
        </svg>
        {lpo.location}
      </a>
      </div>
      
      {lpo.discordUsername && (
        <div class="meta-tag discord-tag">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
             <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
          </svg>
          {lpo.discordUsername}
        </div>
      )}
    </div>

    <section class="profile-bio">
      <p>"{lpo.details || "Contact on Discord for play details."}"</p>
    </section>

    {lpo.places && lpo.places.length > 0 && (
      <section class="profile-venues">
        <h3>Primary Venues</h3>
        <div class="venues-list">
          {lpo.places.map((venue) => (
            <article class="venue-item">
              <div class="venue-info">
                {venue.website ? (
                  <a href={venue.website} target="_blank" rel="nofollow noreferrer" class="venue-name">
                    {venue.place}
                  </a>
                ) : (
                  <span class="venue-name">{venue.place}</span>
                )}
                <span class="venue-frequency">{venue.frequency}</span>
              </div>
              
              {venue.website && (
                  <a href={venue.website} target="_blank" rel="nofollow noreferrer" class="venue-icon" title="Visit Website">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                        <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/>
                    </svg>
                  </a>
              )}
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</article>

<style>
  .lpo-profile-card {
    padding: 0; 
    overflow: hidden; 
    display: flex;
    flex-direction: column;
    position: relative; /* Crucial for absolute positioning the background art */
    z-index: 1;
  }

  /* --- NEW: Background Art Styling --- */
  .profile-bg-art {
    position: absolute;
    top: 60px; /* Starts exactly below the top red banner */
    right: 0;
    bottom: 0;
    width: 45%; /* Fills the right side of the card */
    background-size: cover;
    background-position: center right;
    opacity: 0.25; /* Keeps it strictly as a watermark */
    z-index: -1; /* Pushes it behind all the text */
    pointer-events: none; /* Prevents it from blocking clicks on links */
    
    /* The magic fade: goes from transparent on the left to solid on the right */
    mask-image: linear-gradient(to right, transparent 0%, black 60%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 60%);
  }

  /* Top decorative banner */
  .profile-banner {
    width: 100%;
    height: 60px;
    background: linear-gradient(135deg, var(--accent), #ff7b7b);
    position: relative;
    z-index: 2; /* Sits above the background art */
  }

  /* Main content area */
  .profile-content {
    padding: 0 2rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2; /* Sits above the background art */
  }

  .profile-header {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    margin-top: -30px; 
    margin-bottom: 1rem;
  }

  /* --- NEW: PFP Avatar Styling --- */
  .avatar-circle {
    width: 80px;
    height: 80px;
    background-color: var(--surface);
    border: 4px solid var(--bg);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--heading-color);
    box-shadow: 0 4px 6px rgba(0,0,0,0.2);
    flex-shrink: 0;
    overflow: hidden; 
    position: relative; /* NEW: Anchors the absolute image to this circle */
  }

  .avatar-img {
    position: absolute; /* Rips it out of the Flexbox flow */
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* Now it can crop perfectly without being squished! */
  }

.profile-identity { 
    display: flex; 
    flex-direction: column; 
    align-items: flex-start; 
    padding-bottom: 0.5rem; 
  }

  .profile-identity h2 { 
    margin: 0 0 0.25rem 0; 
    font-size: 1.7rem; 
    color: var(--heading-color); 
    line-height: 1.1; 
  }

  .role-badge { 
    color: var(--accent); 
    font-size: 0.8rem; 
    text-transform: uppercase; 
    letter-spacing: 0.05em; 
    font-weight: 800; 
  }

  /* Meta tags (Discord & Location) */
  .profile-meta-tags { 
    display: flex; 
    flex-wrap: wrap; 
    gap: 1rem; 
    margin-bottom: 1.5rem; 
  }

  .meta-tag { 
    display: flex; 
    align-items: center; 
    gap: 0.4rem; 
    font-size: 0.85rem; 
    color: var(--text-body); 
    background-color: var(--surface); 
    padding: 0.4rem 0.8rem; 
    border-radius: 6px; 
    border: 1px solid var(--border-subtle); 
  }

  .discord-tag { 
    color: #5865F2; 
    background-color: rgba(88, 101, 242, 0.1); 
    border-color: rgba(88, 101, 242, 0.3); 
    font-weight: 600; 
  }

  .location-tag svg { 
    color: var(--text-muted); 
  }

  /* Interactive Tag Styling */
  .clickable-tag {
    text-decoration: none; /* Strips the default blue link underline */
    transition: all 0.2s ease;
  }

  .clickable-tag:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  }

  /* Bio Text */
  .profile-bio { 
    margin-bottom: 2rem; 
    line-height: 1.6; 
    font-size: 1.05rem; 
    color: var(--text-muted); 
    font-style: italic; 
    border-left: 3px solid var(--border-subtle); 
    padding-left: 1rem; 
  }

  /* Venues Section */
  .profile-venues h3 { 
    font-size: 0.9rem; 
    text-transform: uppercase; 
    color: var(--heading-color); 
    margin-bottom: 1rem; 
    letter-spacing: 0.05em; 
    border-bottom: 1px solid var(--border-subtle); 
    padding-bottom: 0.5rem; 
  }

  .venues-list { 
    display: flex; 
    flex-direction: column; 
    gap: 0.75rem; 
  }

  .venue-item { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    padding: 0.5rem 0; 
  }

  .venue-info { 
    display: flex; 
    flex-direction: column; 
  }

  .venue-name { 
    font-weight: bold; 
    color: var(--heading-color); 
    text-decoration: none; 
    font-size: 1.05rem; 
  }

  .venue-name:hover { 
    color: var(--accent); 
    text-decoration: underline; 
  }

  .venue-frequency { 
    font-size: 0.85rem; 
    color: var(--text-muted); 
    margin-top: 0.2rem; 
  }

  .venue-icon { 
    color: var(--border-subtle); 
    transition: color 0.2s; 
  }

  .venue-icon:hover { 
    color: var(--accent); 
  }

  @media (max-width: 600px) {
    .profile-content { 
      padding: 0 1.5rem 1.5rem 1.5rem; 
    }
    
    .profile-header { 
      flex-direction: column; 
      align-items: center; 
      text-align: center; 
      margin-top: -40px; 
    }
    
    .profile-identity { 
      align-items: center; 
      padding-bottom: 0; 
    }
    
    .profile-meta-tags { 
      justify-content: center; 
    }
    
    .profile-bg-art { 
      width: 100%; 
      opacity: 0.08; 
      mask-image: none; 
      -webkit-mask-image: none; 
    } 
    /* On mobile, we make it full width but super faint 
       so the text remains legible */
  }
</style>