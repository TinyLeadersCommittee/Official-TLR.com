---
const { sectionId } = Astro.props;
---

<div id={`details-${sectionId}`} class="details-panel" onclick="closeAllDetails()">
  
  <div class="mtg-card-frame" onclick="event.stopPropagation()">
    
    <button class="close-btn" onclick="closeAllDetails()">×</button>

    <div class="mtg-inner-frame">
      
      <div class="mtg-bar mtg-title-bar">
        <div class="mtg-name member-name-target"></div>
        <div class="mtg-mana mana-target"></div>
      </div>

      <div class="mtg-art-wrapper">
        <img class="mtg-art art-target" src="" alt="Legend Art" />
      </div>

      <div class="mtg-bar mtg-typeline">
        <div class="type-left role-target"></div>
        <div class="set-symbol">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
            <path d="M12 2L2 22h20L12 2z M12 6l5 12H7l5-12z"/>
          </svg>
        </div>
      </div>

      <div class="mtg-textbox-wrapper">
        <div class="mtg-textbox">
          <div class="mtg-watermark">
            <svg viewBox="0 0 100 100" fill="currentColor">
              <polygon points="50,5 95,25 95,75 50,95 5,75 5,25" opacity="0.5"/>
              <polygon points="50,15 80,30 80,70 50,85 20,70 20,30"/>
            </svg>
          </div>

          <div class="mtg-rules-text">
            <p><em>Hails from <span class="hails-target"></span></em></p>
            <p><span class="known-target"></span></p>
            
            <p class="favorite-card-line">
              Favorite Card — 
              <span class="card-hover-wrapper hover-container">
                <span class="card-name card-target"></span>
                <img class="card-hover-img hover-img-target" src="" alt="Card Preview" loading="lazy" style="display: none;" />
              </span>
            </p>
          </div>

          <hr class="mtg-divider" />
          <div class="mtg-flavor-text bio-target"></div>
        </div>

        <div class="mtg-pt-box pt-target"></div>
      </div>

    </div> <div class="mtg-frame-footer">
        <div class="footer-left">
            <strong>001 &nbsp;&nbsp;&nbsp; M</strong><br/>
            TLR • EN &nbsp;&nbsp; 🖌 <span class="since-target"></span>
        </div>
        <div class="footer-right">
            Signature Deck:<br/> <span class="deck-target"></span>
        </div>
    </div>

  </div>
</div>

<style>
  /* --- MODAL OVERLAY STYLES --- */
  .details-panel { 
    position: fixed;
    top: 0; left: 0; 
    width: 100vw; height: 100vh;
    background: rgba(0, 0, 0, 0.85); /* Dark cinematic background */
    backdrop-filter: blur(5px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0; 
    pointer-events: none; /* Prevents clicking when hidden */
    transition: opacity 0.3s ease; 
  }
  .details-panel.open { 
    opacity: 1; 
    pointer-events: all; 
  }
  
  /* OUTER BLACK BORDER */
  .mtg-card-frame {
    --mtg-font: 'Palatino Linotype', 'Book Antiqua', Palatino, serif;
    position: relative;
    width: 90vw;
    max-width: 420px; /* Perfect MTG aspect ratio constraint */
    max-height: 95vh;
    overflow-y: auto; /* Just in case they are on a tiny phone screen */
    background: #111111;
    border-radius: 18px; /* Classic rounded MTG corners */
    padding: 0.6rem 0.6rem 0.8rem 0.6rem; 
    box-shadow: 0 20px 50px rgba(0,0,0,0.8);
    transform: translateY(20px);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  .details-panel.open .mtg-card-frame {
      transform: translateY(0); /* Pops up slightly when opening */
  }

  /* COLORED INNER FRAME */
  .mtg-inner-frame {
    background-color: var(--role-color, #444);
    background-image: linear-gradient(180deg, rgba(255,255,255,0.1) 0%, rgba(0,0,0,0.6) 100%);
    border: 2px solid #000;
    border-radius: 8px;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    box-shadow: inset 0 0 10px rgba(0,0,0,0.5);
  }

  /* TITLE & TYPE BARS */
  .mtg-bar {
    display: flex; justify-content: space-between; align-items: center;
    background: linear-gradient(180deg, #dfdcc5 0%, #c9c4ac 100%); 
    border: 2px solid #000;
    border-radius: 16px;
    padding: 0.2rem 0.8rem;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.4), 0 3px 6px rgba(0,0,0,0.5);
  }

  .mtg-name, .type-left { 
    font-family: var(--mtg-font); font-weight: bold; font-size: 1.1rem; color: #111; 
  }

  /* NEW: MTG ART BOX */
  .mtg-art-wrapper {
    width: 100%;
    aspect-ratio: 4 / 3; /* Classic MTG art ratio */
    border: 2px solid #000;
    box-shadow: inset 0 0 8px rgba(0,0,0,0.6), 0 2px 4px rgba(0,0,0,0.4);
    overflow: hidden;
  }
  .mtg-art {
    width: 100%; height: 100%;
    object-fit: cover; /* Ensures the picture fills the box perfectly without squishing */
    object-position: top center;
  }

  /* MANA DOTS */
  .mtg-mana { display: flex; gap: 2px; }
  :global(.mana-symbol) {
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; height: 20px; border-radius: 50%;
    font-family: Arial, sans-serif; font-weight: bold; font-size: 12px;
    color: #000; box-shadow: -1px 2px 3px rgba(0,0,0,0.8);
  }

  /* TEXT BOX & P/T WRAPPER */
  .mtg-textbox-wrapper {
    position: relative; 
    margin-bottom: 0.2rem;
  }

  .mtg-textbox {
    position: relative;
    background: linear-gradient(180deg, #dfdcc5 0%, #c9c4ac 100%); 
    border: 2px solid #000;
    border-radius: 2px;
    padding: 1.2rem;
    box-shadow: inset 0 0 0 2px rgba(255,255,255,0.3), inset 0 0 10px rgba(0,0,0,0.1);
    overflow: hidden;
  }

  .mtg-watermark {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 250px; height: 250px; opacity: 0.15; color: var(--role-color);
    pointer-events: none; z-index: 0;
  }

  .mtg-rules-text {
    position: relative; z-index: 1;
    font-family: var(--mtg-font); font-size: 1rem; line-height: 1.5; color: #111111;
  }
  .mtg-rules-text p { margin: 0 0 0.5rem 0; }

  /* CARD HOVER */
  .card-hover-wrapper {
    position: relative; display: inline-block; cursor: pointer;
    color: #000; font-weight: bold; 
    border-bottom: 2px dotted var(--role-color, var(--accent)); 
  }
  .card-hover-img {
    position: absolute; bottom: 130%; left: 50%; transform: translateX(-50%) translateY(10px);
    width: 220px; height: auto; border-radius: 4.75% / 3.5%;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    opacity: 0; visibility: hidden; pointer-events: none; z-index: 1000;
    transition: all 0.2s ease-out;
  }
  .card-hover-wrapper.has-image:hover .card-hover-img {
    opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0);
  }

  .mtg-divider {
    position: relative; z-index: 1; border: none; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0,0,0,0.3), transparent);
    margin: 1rem 0;
  }
  
  .mtg-flavor-text {
    position: relative; z-index: 1;
    font-family: var(--mtg-font); font-style: italic;
    font-size: 0.95rem; line-height: 1.4; color: #333333;
  }

  /* THE FIX: PERFECT P/T BOX POSITIONING */
  .mtg-pt-box {
    position: absolute; 
    bottom: -12px; /* Drops it down so it hangs out of the white box */
    right: 4px;   /* Hugs the right side just inside the border */
    background: linear-gradient(180deg, #e4dfc5 0%, #b8b196 100%);
    border: 2px solid #000;
    border-radius: 6px 0 6px 0; 
    padding: 0.2rem 0.8rem;
    font-family: var(--mtg-font); font-weight: bold; font-size: 1.2rem; color: #000;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.6), 0 3px 6px rgba(0,0,0,0.6);
    z-index: 10;
  }

  /* COLLECTOR FOOTER */
  .mtg-frame-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-start; /* Aligns text to the top of the footer */
    padding: 0.5rem 0.4rem 0 0.4rem;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.65rem;
    color: #fff;
    line-height: 1.3;
  }

  .footer-right {
    text-align: right;
    padding-top: 6px; /* Pushes "Signature Deck" down so the P/T box hovers ABOVE it safely */
  }

  .close-btn { 
    position: absolute; top: -15px; right: -15px; z-index: 10;
    background: #111; border: 2px solid var(--role-color); 
    border-radius: 50%; width: 36px; height: 36px; 
    display: flex; align-items: center; justify-content: center; 
    font-size: 1.5rem; color: #fff; cursor: pointer; 
    transition: all 0.2s; box-shadow: 0 4px 6px rgba(0,0,0,0.5);
  }
</style>