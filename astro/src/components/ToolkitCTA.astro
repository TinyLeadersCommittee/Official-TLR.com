---
// src/components/ToolkitCTA.astro
import { SITE_LINKS } from '../config/links.js';
---

<aside id="toolkit" class="toolkit-cta">
  <div class="toolkit-content">
    <h3>Ready to Play?</h3>
    <p>
      Get the tools you need: Cockatrice installation guides, and links to
      Manabox, Moxfield, and Challonge.
    </p>
  </div>
  
  <a href={SITE_LINKS.community.resources} class="toolkit-btn">
    <svg 
      xmlns="http://www.w3.org/2000/svg" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor" 
      stroke-width="2" 
      stroke-linecap="round" 
      stroke-linejoin="round"
    >
      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77
        a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91
        a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
    </svg>
    Open the Player Toolkit
  </a>
</aside>

<style>
  .toolkit-cta {
    display: flex; flex-direction: column; gap: 1.5rem;
    margin: 4rem 0; padding: 2.5rem; border-radius: 12px;
    background: rgba(20, 20, 25, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 5px solid var(--accent);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    align-items: center; text-align: center;
  }

  @media (min-width: 768px) {
    .toolkit-cta {
      flex-direction: row; justify-content: space-between; text-align: left;
    }
  }

  .toolkit-content h3 { 
    font-size: 1.8rem; margin: 0 0 0.5rem 0; color: var(--heading-color); 
  }
  
  .toolkit-content p { 
    margin: 0; font-size: 1.1rem; color: var(--text-body); max-width: 500px; 
  }

  .toolkit-btn {
    display: inline-flex; align-items: center; gap: 0.75rem;
    background: var(--accent); color: #fff; padding: 1rem 1.5rem; 
    border-radius: 8px; font-size: 1.1rem; font-weight: bold; 
    text-decoration: none; white-space: nowrap; transition: all 0.2s ease;
  }

  .toolkit-btn svg { width: 20px; height: 20px; }

  .toolkit-btn:hover {
    transform: translateY(-3px); filter: brightness(115%);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }

  :global([data-theme="light"]) .toolkit-cta,
  :global([data-theme="charlotte"]) .toolkit-cta {
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-left: 5px solid var(--accent);
    box-shadow: 0 8px 30px rgba(0,0,0,0.05);
  }
</style>