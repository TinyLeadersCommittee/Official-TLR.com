---
/* Component Props */
const { cards } = Astro.props;
---

<ul class="card-gallery-grid">
  {cards.map(card => {
    /* Image URI Extraction */
    const imgUri = card.image_uris?.normal || card.card_faces?.[0]?.image_uris?.normal || '';
    
    return (
      <li class="gallery-item">
        <img 
          src={imgUri} 
          alt={card.name} 
          title={card.name}
          loading="lazy" 
          class="gallery-img card-trigger" 
          data-image={imgUri} 
        />
      </li>
    )
  })}
</ul>

<style>
  /* --- GALLERY GRID CONTAINER --- */
  .card-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); /* Responsive auto-wrap */
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .gallery-item {
    display: flex;
    justify-content: center;
  }

  /* --- CARD IMAGE STYLING --- */
  .gallery-img {
    width: 100%;
    height: auto;
    border-radius: 4.75% / 3.5%; /* Standard MTG Card Corner Radius */
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .gallery-img:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 8px 16px rgba(0,0,0,0.5);
  }
</style>