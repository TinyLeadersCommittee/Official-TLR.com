---
// src/components/DiscordBanner.astro
import { discordBanner } from '../data/discover/discover.js';
---

<section id="discord" class="floating-discord-section">
  <div 
    class="discord-bg-image" 
    style={`background-image: url('${discordBanner.bgImg.src}');`}
  ></div>
  
  <div class="banner-content">
    <h2>{discordBanner.heading}</h2>
    <p class="banner-lead">{discordBanner.lead}</p>
    
    <ul class="banner-list">
      {discordBanner.bullets.map((bullet) => (
        <li>{bullet}</li>
      ))}
    </ul>
    
    <a 
      href={discordBanner.buttonUrl} 
      class="discord-logo-btn" 
      target="_blank" 
      rel="noopener noreferrer"
    >
      <svg 
        xmlns="http://www.w3.org/2000/svg" 
        viewBox="0 0 127.14 96.36" 
        class="discord-svg"
      >
        <path fill="#ffffff" d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0
          a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,
          72.37,0,0,0,45.64,0,105.09,105.09,0,0,0,19.39,8.09C2.79,32.65
          -1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.11,
          77.11,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,
          1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,
          2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1
          A105.89,105.89,0,0,0,126.6,80.22c1.24-23.37-3.55-47.54-19.9
          -72.05ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43
          -12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,
          65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,
          91.08,65.69,84.69,65.69Z"/>
      </svg>
      <span>{discordBanner.buttonText}</span>
    </a>
  </div>
</section>

<style>
  .floating-discord-section {
    position: relative; margin: 2rem 0; padding: 2.5rem 1.25rem; 
    background: rgba(20, 20, 25, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px;
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    overflow: hidden; 
  }

  .discord-bg-image {
    position: absolute; top: 0; right: 0; width: 100%; height: 100%;
    background-size: cover; background-position: center left; 
    background-repeat: no-repeat; z-index: 0;
    
    -webkit-mask-image: 
      linear-gradient(to right, transparent 0%, black 25%),
      linear-gradient(
        to bottom, transparent 0%, black 15%, black 85%, transparent 100%
      );
    mask-image: 
      linear-gradient(to right, transparent 0%, black 25%),
      linear-gradient(
        to bottom, transparent 0%, black 15%, black 85%, transparent 100%
      );
      
    -webkit-mask-composite: source-in; mask-composite: intersect;
    opacity: 0.4;
  }

  @media (min-width: 768px) {
    .floating-discord-section { margin: 4rem 0; padding: 4rem 3rem; }
    .discord-bg-image { width: 65%; opacity: 0.95; }
  }

  :global([data-theme="light"]) .floating-discord-section,
  :global([data-theme="charlotte"]) .floating-discord-section {
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 30px rgba(0,0,0,0.05);
  }

  .banner-content {
    position: relative; z-index: 2; width: 100%; margin: 0; 
    display: flex; flex-direction: column; 
    align-items: flex-start; text-align: left;
  }

  h2 { 
    color: var(--heading-color); font-size: 2.5rem; margin-bottom: 0.5rem; 
  }
  
  .banner-lead { 
    font-size: 1.1rem; color: var(--text-body); margin-bottom: 1.5rem; 
  }
  
  .banner-list {
    text-align: left; color: var(--text-body); margin-bottom: 2rem; 
    font-size: 0.95rem; line-height: 1.6; 
    background: rgba(255, 255, 255, 0.05); 
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1rem 1.5rem 1rem 2.5rem;
    border-radius: 8px; border-left: 3px solid var(--accent);
  }
  
  :global([data-theme="light"]) .banner-list,
  :global([data-theme="charlotte"]) .banner-list {
    background: rgba(0, 0, 0, 0.05); border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .banner-list li { margin-bottom: 0.4rem; }

  .discord-logo-btn {
    display: inline-flex; align-items: center; gap: 0.75rem;
    background-color: #5865F2; padding: 0.8rem 1.5rem; border-radius: 8px;
    text-decoration: none; color: #fff; font-weight: bold; font-size: 1.1rem;
    transition: transform 0.2s, background-color 0.2s; 
    box-shadow: 0 4px 15px rgba(88, 101, 242, 0.4);
  }
  
  .discord-svg { width: 28px; height: auto; display: block; flex-shrink: 0; }
  
  .discord-logo-btn:hover { 
    transform: translateY(-2px); background-color: #4752C4; 
    box-shadow: 0 6px 20px rgba(88, 101, 242, 0.6); 
  }
</style>