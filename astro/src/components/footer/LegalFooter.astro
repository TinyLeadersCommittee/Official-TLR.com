---
// src/components/LegalFooter.astro
import { legalBlocks, devCredits } from '../../data/footer/legal-footer.js';

const today = new Date();
---

<div class="legal-section">
  
  {/* 1. Dynamically render all the legal blocks */}
  {legalBlocks.map(block => (
    <div class="legal-block">
      <h4>{block.title}</h4>
      {block.paragraphs.map(text => (
        <p set:html={text}></p>
      ))}
    </div>
  ))}

  {/* 2. The Copyright & Dev Credits (Appended to the bottom) */}
  <div class="legal-block">
    <p class="copyright">
      &copy; {today.getFullYear()} Tiny Leaders Reborn Committee. All rights reserved.
    </p>
    
    <div class="dev-credit">
      <p>
        {devCredits.lead.role}: 
        <a href={devCredits.lead.url} target="_blank" class="architect-name">
          {devCredits.lead.name}
        </a>
      </p>
      <p class="team-sub">
        {devCredits.team.role} 
        <a href={devCredits.team.url} target="_blank" class="team-link">
          {devCredits.team.name}
        </a>
      </p>
    </div>
  </div>

</div>

<style>
  /* --- LEGAL SECTION STYLES --- */
  .legal-section {
    display: flex; flex-direction: column; gap: 1.5rem; 
    text-align: center; padding: 2rem 1rem;
    max-width: 800px; margin: 0 auto;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .legal-block h4 {
    color: var(--footer-text, #ccc); font-size: 0.75rem;
    text-transform: uppercase; letter-spacing: 0.05em;
    font-weight: 700; margin-bottom: 0.5rem; opacity: 0.8;
  }

  /* Used --footer-text instead of the global body text variable */
  .legal-block :global(p) {
    font-size: 0.7rem; 
    color: var(--footer-text); 
    opacity: 0.7;
    line-height: 1.5; 
    margin: 0 auto 0.5rem auto;
    max-width: 700px;
  }

  /* Force white so names pop against the universally dark footer */
  .legal-block :global(strong) {
    color: #ffffff; 
  }

  .legal-block :global(a) {
    color: var(--footer-text); 
    text-decoration: underline;
    transition: color 0.2s, opacity 0.2s;
  }
  
  .legal-block :global(a:hover) { 
    color: var(--accent); 
    opacity: 1;
  }

  .copyright { margin-top: 0.5rem; opacity: 0.5; color: var(--footer-text); }

  /* --- CREDIT STYLES --- */
  .dev-credit {
    margin-top: 1.5rem; display: flex; flex-direction: column;
    gap: 0.2rem; align-items: center; color: var(--footer-text);
  }

  .dev-credit p {
    margin: 0; font-size: 0.7rem; opacity: 0.5; transition: opacity 0.2s ease;
  }

  .dev-credit:hover p { opacity: 1; }

  /* Force white instead of --heading-color */
  .architect-name {
    color: #ffffff; font-weight: 700; text-decoration: none;
  }

  .team-link { color: var(--accent); text-decoration: none; }
  .architect-name:hover, .team-link:hover { text-decoration: underline; }
</style>