---
const { tool } = Astro.props;
---

<article class="media-card">
  <div 
    class="media-card-img" 
    style={`
        background-image: url('${tool.image.src || tool.image}'); 
        background-size: ${tool.bgSize || 'cover'};
        background-color: ${tool.bgColor || 'var(--surface)'};
    `}
  ></div>
  
  <div class="media-card-body">
    <p class="tool-description">{tool.description}</p>
    
    {tool.hasGuide && (
      <button id="open-mtgo-guide" class="btn-tool-secondary">
        View Setup Guide
      </button>
    )}

    <footer class="media-card-footer">
      <a href={tool.link} target="_blank" class="btn-tool">{tool.linkText}</a>
    </footer>
  </div>
</article>

<style>
  .media-card-img {
    height: 180px; 
    background-position: center;
    background-repeat: no-repeat;
  }

  .media-card-body {
    justify-content: space-between; 
  }

  .tool-description {
    font-size: 1.1rem; 
    color: var(--text-body);
    line-height: 1.75;
    margin: 0 0 1.5rem 0;
    flex-grow: 1; 
  }

  .media-card-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .btn-tool {
    display: block; 
    width: 100%;    
    box-sizing: border-box; 
    font-size: 0.95rem; 
    font-weight: bold;
    color: var(--accent);
    text-decoration: none;
    border: 1px solid var(--border-subtle);
    padding: 0.75rem 1.25rem;
    border-radius: 4px;
    transition: all 0.2s;
    background-color: var(--bg);
    text-align: center;
    cursor: pointer;
  }
  .btn-tool:hover {
    background-color: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .btn-tool-secondary {
    display: block;
    width: 100%;
    margin-bottom: 1.5rem; 
    padding: 0.75rem 1.25rem;
    font-size: 0.95rem;
    font-weight: bold;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
    box-sizing: border-box;
  }
  .btn-tool-secondary:hover {
    border-color: var(--accent);
    color: var(--heading-color);
    background-color: var(--surface);
  }
</style>