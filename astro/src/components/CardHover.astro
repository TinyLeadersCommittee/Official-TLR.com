---
/* Component Props */
const { name, imageUri } = Astro.props;
---

<span class="card-hover-wrapper card-trigger" data-image={imageUri}>
  <span class="card-name">{name}</span>
  
  {/* Hover Image Reveal */}
  {imageUri && (
    <img src={imageUri} alt={name} class="card-hover-img" loading="lazy" />
  )}
</span>

<style>
  /* --- WRAPPER --- */
  .card-hover-wrapper {
    position: relative;
    display: inline-block;
    color: var(--accent); 
    font-weight: 600;
    cursor: pointer;
    border-bottom: 1px dotted var(--accent);
    transition: color 0.2s;
  }

  .card-hover-wrapper:hover {
    color: var(--heading-color);
  }

  /* --- FLOATING IMAGE OVERLAY --- */
  .card-hover-img {
    position: absolute;
    bottom: 130%; 
    left: 50%;
    transform: translateX(-50%) translateY(10px); 
    
    width: 220px; 
    height: auto;
    border-radius: 4.75% / 3.5%; /* Standard MTG Card Corner Radius */
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    
    opacity: 0;
    visibility: hidden;
    pointer-events: none; 
    z-index: 1000; 
    
    transition: all 0.2s ease-out;
  }

  /* --- HOVER STATE ANIMATION --- */
  .card-hover-wrapper:hover .card-hover-img {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
</style>